# PromotionPilot AI - cấu hình môi trường (KHÔNG commit file .env thật lên git)

# (Tùy chọn) API key cho LLM để sinh nội dung campaign (Facebook/Zalo/SMS copy) và diễn giải tự nhiên hơn.
# Nếu để trống, hệ thống tự động dùng template rule-based bằng tiếng Việt (không cần internet).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Không bao giờ gửi dữ liệu giao dịch chi tiết (transaction-level) cho LLM.
# Chỉ gửi số liệu tổng hợp (aggregated summary) khi sinh nội dung.
LLM_ENABLED=false

# (Tuỳ chọn) Mã truy cập demo. Để trống = không yêu cầu mã.
# Đặt giá trị (vd PROMO2026) khi deploy bản demo công khai.
DEMO_ACCESS_CODE=

# Demo nhiều người cùng lúc: số job forecast/basket chạy song song tối đa.
DEMO_MAX_HEAVY_JOBS=10

# Giới hạn kích thước file upload khi dùng thử (MB). Nút dữ liệu mẫu không bị ảnh hưởng.
DEMO_MAX_UPLOAD_MB=30
